<UserControl x:Class="Circuiting.UI.DockablePanel.CircuitManagerPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2D2D2D" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="DB Circuit Manager"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="AUTO"
                               Foreground="#4EC94E"
                               FontSize="11"
                               FontWeight="Bold"
                               Margin="0,0,6,0"
                               VerticalAlignment="Center"
                               x:Name="AutoModeLabel"/>
                    <ToggleButton x:Name="ModeToggle"
                                  Width="44" Height="22"
                                  Checked="ModeToggle_Checked"
                                  Unchecked="ModeToggle_Unchecked"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="#252525" Padding="8,6">
            <WrapPanel>
                <Button x:Name="AddBoardButton"
                Content="+ Add Board"
                Click="AddBoardButton_Click"
                Background="#0078D4"
                Foreground="White"
                BorderThickness="0"
                Padding="10,4"
                Margin="0,0,4,2"
                Cursor="Hand"/>

                <Button x:Name="UndoButton"
                Content="↩ Undo"
                Click="UndoButton_Click"
                Background="#3C3C3C"
                Foreground="White"
                BorderThickness="0"
                Padding="10,4"
                Margin="0,0,4,2"
                Cursor="Hand"/>

                <Button x:Name="RedoButton"
                Content="↪ Redo"
                Click="RedoButton_Click"
                Background="#3C3C3C"
                Foreground="White"
                BorderThickness="0"
                Padding="10,4"
                Margin="0,0,4,2"
                Cursor="Hand"/>

                <Button x:Name="RefreshButton"
                Content="↺ Refresh"
                Click="RefreshButton_Click"
                Background="#3C3C3C"
                Foreground="White"
                BorderThickness="0"
                Padding="10,4"
                Margin="0,0,4,2"
                Cursor="Hand"/>

                <Button x:Name="ExpandAllButton"
                Content="▼ Expand"
                Click="ExpandAllButton_Click"
                Background="#3C3C3C"
                Foreground="White"
                BorderThickness="0"
                Padding="10,4"
                Margin="0,0,4,2"
                Cursor="Hand"/>

                <Button x:Name="CollapseAllButton"
                Content="▲ Collapse"
                Click="CollapseAllButton_Click"
                Background="#3C3C3C"
                Foreground="White"
                BorderThickness="0"
                Padding="10,4"
                Margin="0,0,0,2"
                Cursor="Hand"/>
            </WrapPanel>
        </Border>

        <!-- Tree View -->
        <TreeView x:Name="BoardTree"
                  Grid.Row="2"
                  Background="#1E1E1E"
                  Foreground="White"
                  BorderThickness="0"
                  Padding="4"/>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="#2D2D2D" Padding="10,5">
            <TextBlock x:Name="StatusLabel"
                       Text="Ready"
                       Foreground="#AAAAAA"
                       FontSize="11"/>
        </Border>
    </Grid>
</UserControl>