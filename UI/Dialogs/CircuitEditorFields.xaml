<UserControl x:Class="Circuiting.UI.Dialogs.CircuitEditorFields"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock x:Name="HeaderText" Foreground="White" FontSize="13"
                   FontWeight="SemiBold" Margin="0,0,0,10"/>
        <TextBlock Text="Description:" Foreground="#C8C8C8" FontSize="12" Margin="0,0,0,3"/>
        <TextBox x:Name="DescriptionBox" FontSize="12" Padding="4,3" Margin="0,0,0,8"/>
        <TextBlock Text="Breaker Size:" Foreground="#C8C8C8" FontSize="12" Margin="0,0,0,3"/>
        <ComboBox x:Name="BreakerCombo" FontSize="12" Padding="4,3" Margin="0,0,0,8"/>
        <TextBlock Text="Protection:" Foreground="#C8C8C8" FontSize="12" Margin="0,0,0,3"/>
        <ComboBox x:Name="ProtectionCombo" FontSize="12" Padding="4,3" Margin="0,0,0,8"/>
        <TextBlock Text="Earth Leakage:" Foreground="#C8C8C8" FontSize="12" Margin="0,0,0,3"/>
        <ComboBox x:Name="LeakageCombo" FontSize="12" Padding="4,3" Margin="0,0,0,8"/>
        <TextBlock Text="Poles:" Foreground="#C8C8C8" FontSize="12" Margin="0,0,0,3"/>
        <ComboBox x:Name="PolesCombo" FontSize="12" Padding="4,3" Margin="0,0,0,8"/>
    </StackPanel>
</UserControl>
