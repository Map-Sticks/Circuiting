<Window x:Class="Circuiting.UI.Dialogs.NewCircuitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:Circuiting.UI.Dialogs"
        Title="New Circuit" Width="380" SizeToContent="Height" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" Background="#1E1E1E">
    <StackPanel Margin="16">
        <TextBlock x:Name="IntroText" Foreground="#C8C8C8" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <dialogs:CircuitEditorFields x:Name="Fields"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="80" Padding="0,4" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Create" Width="80" Padding="0,4" Background="#0078D4"
                    Foreground="White" BorderThickness="0" IsDefault="True" Click="Create_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
