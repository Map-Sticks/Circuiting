<Window x:Class="Circuiting.UI.Dialogs.AddBoardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Distribution Board" Width="380" Height="260"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#1E1E1E">
    <StackPanel Margin="20">
        <TextBlock Text="Board Name:" Foreground="White" FontSize="13" Margin="0,0,0,6"/>
        <TextBox x:Name="NameBox" Text="DB-L1" FontSize="13" Padding="6,4" Margin="0,0,0,16"/>
        <TextBlock Text="Supply:" Foreground="White" FontSize="13" Margin="0,0,0,6"/>
        <RadioButton x:Name="ThreePhaseRadio" Content="3 Phase" Foreground="White"
                     FontSize="13" IsChecked="True" Margin="0,0,0,4"/>
        <RadioButton Content="Single Phase" Foreground="White" FontSize="13" Margin="0,0,0,16"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="80" Padding="0,4" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Add" Width="80" Padding="0,4" Background="#0078D4"
                    Foreground="White" BorderThickness="0" IsDefault="True" Click="Add_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
