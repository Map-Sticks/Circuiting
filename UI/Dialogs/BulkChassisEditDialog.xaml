<Window x:Class="Circuiting.UI.Dialogs.BulkChassisEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400" Height="580" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" Background="#1E1E1E">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock x:Name="IntroText" Foreground="#C8C8C8" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                       Visibility="Collapsed"/>
            <StackPanel x:Name="ScopePanel">
            <TextBlock Text="Apply to:" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <RadioButton x:Name="AllRadio" Content="All circuits" Foreground="White" FontSize="13"
                         IsChecked="True" Margin="0,0,0,3"/>
            <RadioButton x:Name="SpareRadio" Content="Spaces only (no saved details or fixtures)" Foreground="White" FontSize="13" Margin="0,0,0,3"/>
            <RadioButton x:Name="LeftRadio" Content="Left side only" Foreground="White" FontSize="13" Margin="0,0,0,3"/>
            <RadioButton x:Name="RightRadio" Content="Right side only" Foreground="White" FontSize="13" Margin="0,0,0,16"/>
            </StackPanel>
            <CheckBox x:Name="BreakerCheck" Content="Breaker Size:" Foreground="White" FontSize="13" Margin="0,0,0,4"/>
            <ComboBox x:Name="BreakerCombo" FontSize="12" Padding="4,3" Margin="20,0,0,8"/>
            <CheckBox x:Name="ProtectionCheck" Content="Protection:" Foreground="White" FontSize="13" Margin="0,0,0,4"/>
            <ComboBox x:Name="ProtectionCombo" FontSize="12" Padding="4,3" Margin="20,0,0,8"/>
            <CheckBox x:Name="LeakageCheck" Content="Earth Leakage:" Foreground="White" FontSize="13" Margin="0,0,0,4"/>
            <ComboBox x:Name="LeakageCombo" FontSize="12" Padding="4,3" Margin="20,0,0,8"/>
            <CheckBox x:Name="TripCurveCheck" Content="Trip Curve:" Foreground="White" FontSize="13" Margin="0,0,0,4"
                      ToolTip="MCB/RCBO tripping characteristic"/>
            <ComboBox x:Name="TripCurveCombo" FontSize="12" Padding="4,3" Margin="20,0,0,8"/>
            <CheckBox x:Name="TripSettingCheck" Content="Trip Setting:" Foreground="White" FontSize="13" Margin="0,0,0,4"
                      ToolTip="Adjustable breaker settings, e.g. Ir 0.8×In, Isd 6×Ir. Leave empty to clear."/>
            <TextBox x:Name="TripSettingBox" FontSize="12" Padding="4,3" Margin="20,0,0,8"/>
            <CheckBox x:Name="DescriptionCheck" Content="Description:" Foreground="White" FontSize="13" Margin="0,0,0,4"/>
            <TextBox x:Name="DescriptionBox" FontSize="12" Padding="4,3" Margin="20,0,0,8"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" Width="80" Padding="0,4" Margin="0,0,8,0" IsCancel="True"/>
                <Button Content="Apply" Width="80" Padding="0,4" Background="#0078D4"
                        Foreground="White" BorderThickness="0" IsDefault="True" Click="Apply_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
